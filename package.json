{
  "name": "ferreteria-barrios-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@barrios/web",
    "dev:api": "turbo run dev --filter=@barrios/api",
    "build:web": "turbo run build --filter=@barrios/web",
    "build:api": "turbo run build --filter=@barrios/api",
    "test:web": "turbo run test --filter=@barrios/web",
    "test:api": "turbo run test --filter=@barrios/api",
    "start:web": "npm run start --workspace=@barrios/web",
    "start:api": "npm run start --workspace=@barrios/api"
  },
  "devDependencies": {
    "turbo": "^2.8.19"
  }
}
