{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontServicePrincipalReadOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REEMPLAZAR_NOMBRE_BUCKET/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::REEMPLAZAR_ACCOUNT_ID:distribution/REEMPLAZAR_DISTRIBUTION_ID"
        }
      }
    }
  ]
}
