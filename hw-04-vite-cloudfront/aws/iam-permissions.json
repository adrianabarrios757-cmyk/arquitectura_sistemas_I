{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyDeploymentBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REEMPLAZAR_NOMBRE_BUCKET"
    },
    {
      "Sid": "WriteOnlyDeploymentBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REEMPLAZAR_NOMBRE_BUCKET/*"
    },
    {
      "Sid": "InvalidateOnlyDeploymentDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation"],
      "Resource": "arn:aws:cloudfront::REEMPLAZAR_ACCOUNT_ID:distribution/REEMPLAZAR_DISTRIBUTION_ID"
    }
  ]
}
